# Create a key at https://aistudio.google.com/app/apikey. Never commit a real key.
GEMINI_API_KEY=

# Current Gemini Interactions API models. Override if your account uses other IDs.
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Local durable state. Relative paths are resolved from the repository root.
DATABASE_PATH=data/gradion.db
DATA_ROOT=data/files

# A RUNNING step becomes explicitly recoverable after this many milliseconds.
STEP_STALE_AFTER_MS=600000

# Optional session lifetime (30 days by default).
SESSION_TTL_MS=2592000000
